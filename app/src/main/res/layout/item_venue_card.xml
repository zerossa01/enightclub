<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootCard"
    style="@style/Widget.ENightClub.Card.Dark"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_base"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Venue Image -->
        <ImageView
            android:id="@+id/venueImage"
            android:layout_width="match_parent"
            android:layout_height="@dimen/venue_card_image_height"
            android:background="@color/bg_elevated"
            android:contentDescription="@string/cd_venue_image"
            android:scaleType="centerCrop"
            tools:src="@color/neon_cyan_dark"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Gradient Overlay -->
        <View
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/bg_overlay_gradient_bottom"
            app:layout_constraintBottom_toBottomOf="@id/venueImage" />

        <!-- Open Now Badge -->
        <TextView
            android:id="@+id/openNowBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_sm"
            android:background="@drawable/bg_button_gradient"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="Open Now"
            android:textAppearance="@style/TextAppearance.ENightClub.Caption"
            android:textColor="@color/text_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Rating Badge -->
        <androidx.cardview.widget.CardView
            android:id="@+id/ratingBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_sm"
            app:cardBackgroundColor="@color/white_10"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/venueImage">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_star_filled" />

                <TextView
                    android:id="@+id/ratingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="4.8"
                    android:textAppearance="@style/TextAppearance.ENightClub.Caption"
                    android:textColor="@color/text_primary" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Venue Name -->
        <TextView
            android:id="@+id/venueName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_base"
            android:layout_marginEnd="@dimen/spacing_base"
            android:layout_marginTop="@dimen/spacing_md"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="The Underground Lounge"
            android:textAppearance="@style/TextAppearance.ENightClub.Subtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/venueImage" />

        <!-- Venue Type -->
        <TextView
            android:id="@+id/venueType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_base"
            android:layout_marginTop="4dp"
            android:text="Nightclub • EDM • VIP Areas"
            android:textAppearance="@style/TextAppearance.ENightClub.Caption"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/venueName" />

        <!-- Distance -->
        <TextView
            android:id="@+id/venueDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_base"
            android:layout_marginTop="2dp"
            android:drawableStart="@drawable/ic_venues"
            android:drawablePadding="4dp"
            android:drawableTint="@color/neon_cyan"
            android:text="0.8 mi away"
            android:textAppearance="@style/TextAppearance.ENightClub.Caption.Tertiary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/venueType" />

        <!-- Review count -->
        <TextView
            android:id="@+id/reviewCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_base"
            android:text="342 reviews"
            android:textAppearance="@style/TextAppearance.ENightClub.Caption.Tertiary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/venueDistance" />

        <!-- Reserve Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/reserveBtn"
            style="@style/Widget.ENightClub.Button.NeonPurple"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_sm"
            android:layout_marginStart="@dimen/spacing_base"
            android:layout_marginEnd="@dimen/spacing_base"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_base"
            android:text="@string/venues_reserve_table"
            android:textSize="@dimen/text_caption"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/venueDistance" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
