<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.ENightClub.Card.Dark"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_base">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_base">

        <!-- Avatar -->
        <ImageView
            android:id="@+id/feedAvatar"
            android:layout_width="@dimen/avatar_md"
            android:layout_height="@dimen/avatar_md"
            android:background="@drawable/bg_avatar_placeholder"
            android:contentDescription="@string/cd_profile_picture"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Name + Time -->
        <TextView
            android:id="@+id/feedUserName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Jessica Chen"
            android:textAppearance="@style/TextAppearance.ENightClub.Subtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/feedAvatar"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/feedAction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginTop="2dp"
            android:text="is attending Neon Nights Festival"
            android:textAppearance="@style/TextAppearance.ENightClub.Body.Secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/feedAvatar"
            app:layout_constraintTop_toBottomOf="@id/feedUserName" />

        <TextView
            android:id="@+id/feedTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginTop="4dp"
            android:drawableStart="@drawable/ic_clock"
            android:drawablePadding="4dp"
            android:drawableTint="@color/text_tertiary"
            android:text="2h ago"
            android:textAppearance="@style/TextAppearance.ENightClub.Caption.Tertiary"
            app:layout_constraintStart_toEndOf="@id/feedAvatar"
            app:layout_constraintTop_toBottomOf="@id/feedAction" />

        <!-- Feed Image (optional) -->
        <ImageView
            android:id="@+id/feedImage"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="@dimen/spacing_base"
            android:background="@color/bg_elevated"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/feedTime" />

        <!-- Action Buttons -->
        <LinearLayout
            android:id="@+id/actionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/feedImage">

            <!-- Like -->
            <ImageButton
                android:id="@+id/likeBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_like_button"
                android:padding="8dp"
                android:src="@drawable/ic_heart_outline" />

            <TextView
                android:id="@+id/likeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-4dp"
                android:text="24"
                android:textAppearance="@style/TextAppearance.ENightClub.Caption" />

            <!-- Comment -->
            <ImageButton
                android:id="@+id/commentBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/spacing_md"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_comment_button"
                android:padding="8dp"
                android:src="@drawable/ic_comment" />

            <TextView
                android:id="@+id/commentCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-4dp"
                android:text="8"
                android:textAppearance="@style/TextAppearance.ENightClub.Caption" />

            <!-- Share -->
            <ImageButton
                android:id="@+id/shareBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/spacing_md"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_share_button"
                android:padding="8dp"
                android:src="@drawable/ic_share" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Attend Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/attendBtn"
                style="@style/Widget.ENightClub.Button.Pill"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:paddingStart="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md"
                android:text="Join"
                android:textSize="12sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
