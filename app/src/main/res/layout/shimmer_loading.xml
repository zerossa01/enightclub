<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:shimmer_auto_start="true"
        app:shimmer_base_alpha="@color/shimmer_base"
        app:shimmer_highlight_alpha="@color/shimmer_highlight"
        app:shimmer_duration="1200"
        app:shimmer_shape="linear">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Bar shimmer -->
            <View
                android:layout_width="180dp"
                android:layout_height="28dp"
                android:layout_marginStart="@dimen/spacing_base"
                android:layout_marginTop="@dimen/spacing_xxl"
                android:background="@drawable/shimmer_placeholder" />

            <View
                android:layout_width="240dp"
                android:layout_height="14dp"
                android:layout_marginStart="@dimen/spacing_base"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/shimmer_placeholder" />

            <!-- Search bar shimmer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/search_bar_height"
                android:layout_marginStart="@dimen/spacing_base"
                android:layout_marginEnd="@dimen/spacing_base"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/shimmer_placeholder" />

            <!-- Cards shimmer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_base">

                <View
                    android:layout_width="@dimen/event_card_width"
                    android:layout_height="280dp"
                    android:layout_marginEnd="@dimen/spacing_base"
                    android:background="@drawable/shimmer_placeholder" />

                <View
                    android:layout_width="@dimen/event_card_width"
                    android:layout_height="280dp"
                    android:layout_marginEnd="@dimen/spacing_base"
                    android:background="@drawable/shimmer_placeholder" />
            </LinearLayout>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
